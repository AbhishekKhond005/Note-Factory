{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_API_URL": "https://note-factory-api.fly.dev"
  },
  "rewrites": [
    {
      "source": "/files/:path*",
      "destination": "https://note-factory-api.fly.dev/files/:path*"
    }
  ]
}
